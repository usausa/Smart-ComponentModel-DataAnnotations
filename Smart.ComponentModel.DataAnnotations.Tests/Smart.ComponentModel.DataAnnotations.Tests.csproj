<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Smart</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
  </PropertyGroup>

  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="SourceGenerateHelper.Testing" Version="2.0.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Smart.ComponentModel.DataAnnotations.Generator\Smart.ComponentModel.DataAnnotations.Generator.csproj" OutputItemType="analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Smart.ComponentModel.DataAnnotations.Generator\Smart.ComponentModel.DataAnnotations.Generator.csproj" ReferenceOutputAssembly="true" />
    <ProjectReference Include="..\Smart.ComponentModel.DataAnnotations\Smart.ComponentModel.DataAnnotations.csproj" />
    <ProjectReference Include="..\Smart.ComponentModel.DataAnnotations.AspNetCore\Smart.ComponentModel.DataAnnotations.AspNetCore.csproj" />
    <ProjectReference Include="..\Smart.ComponentModel.DataAnnotations.Japanese\Smart.ComponentModel.DataAnnotations.Japanese.csproj" />
  </ItemGroup>

</Project>
